  <script>
    // Already signed in — go straight to the product. (Unchanged behaviour.)
    const sess = JSON.parse(localStorage.getItem('twin_session') || '{}');
    if (sess.token) {
      window.location.href = 'dashboard.html';
    }
    // Paint the correct palette before first frame so a reload never flashes
    // the wrong theme. i18n.js remains the owner of the toggle and the stored
    // value; this only mirrors it early.
    try {
      document.documentElement.setAttribute(
        'data-theme',
        localStorage.getItem('moneykal_theme') === 'dark' ? 'dark' : 'light'
      );
    } catch (e) { document.documentElement.setAttribute('data-theme', 'light'); }
  </script>
</head>

