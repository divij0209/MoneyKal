GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
# ---------------------------------------------------------------------------
# Database — the shared Supabase development database.
#
# Copy the "Session pooler" URI from your Supabase project:
#   Dashboard > Connect > Session pooler
# and paste it here with YOUR-PASSWORD replaced by the database password.
#
# Use the SESSION pooler (port 5432), not the Transaction pooler (6543): the
# transaction pooler does not support the prepared statements and session-level
# DDL that Alembic migrations need. The direct db.<ref>.supabase.co host is
# IPv6-only on the free plan and will simply time out on most home networks.
#
# If your password contains @ : / ? # or %, percent-encode it (@ -> %40).
# sslmode=require is added automatically for non-local hosts, but being
# explicit here does no harm.
#
# Ask the team lead for the project ref, region and password. Never commit
# this file — backend/.env is gitignored, and it must stay that way.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# For a private local PostgreSQL instead, e.g.:
# DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@localhost:5432/zenith

# --- Database behaviour flags (all optional; defaults shown) ----------------
# Shown next to your connection in Supabase > Database > Roles, so the team can
# tell whose backend is holding a connection. Defaults to moneykal-<hostname>.
# DB_APP_NAME=moneykal-yourname
#
# Create missing tables directly from the models on startup. Off by default and
# REFUSED against a remote database — the shared schema is Alembic's job.
# Only useful against a private local database.
# DB_AUTO_CREATE=false
#
# Connection pool. Keep these small: the pool is per developer and the hosted
# connection budget is shared by the whole team.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_RECYCLE=1800
# DB_CONNECT_TIMEOUT=10
# DB_ECHO=false

# --- Background jobs -------------------------------------------------------
# Off by default. These send real WhatsApp messages and scan real Gmail
# inboxes, so if every developer ran them against the shared database each
# user would get every reminder once per running backend. Turn on only on the
# one machine designated to run them.
# ENABLE_SCHEDULER=false
# Signing key for every token this app issues: access tokens, refresh tokens,
# Gmail OAuth state and Vapi voice tickets.
#
# MUST be byte-identical for every developer sharing a database. Tokens are
# issued by whichever backend you logged in through and validated by whichever
# one serves your next request; if the keys differ you get 401s that look
# random and are miserable to debug.
#
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# Then get the team's value from the password manager instead -- do not invent
# your own. There is no default: the backend refuses to start without this, and
# refuses to start with a placeholder.
JWT_SECRET=

# --- Web origins (all optional; defaults shown) -----------------------------
# Comma-separated browser origins allowed to call the API. The default "*" is
# safe for this API (bearer tokens, no cookies), but set real hostnames in
# production, e.g. https://app.moneykal.com,https://moneykal.com
# CORS_ALLOW_ORIGINS=*
# Where the Gmail OAuth callback sends a web user back to.
# FRONTEND_URL=http://localhost:5500
# Deep-link scheme the Gmail OAuth callback uses to return to the mobile app.
# MOBILE_REDIRECT_SCHEME=moneykal

# --- Demo accounts ----------------------------------------------------------
# Password for the two accounts backend/seed_demo_accounts.py creates. Required
# only to run that script, which refuses to start without it. Get the team's
# value from the password manager; never commit it.
DEMO_ACCOUNT_PASSWORD=

# --- Plans & Billing --------------------------------------------------------
# How checkout takes payment. "demo" (the default) simulates a successful
# payment: nothing is charged and the purchase is granted, so the whole
# upgrade journey can be shown without a gateway. No real gateway is wired
# yet, so any other value makes checkout refuse payment instead.
# PAYMENT_MODE=demo
#
# Whether the simulated UPI QR checkout may grant a purchase. Left unset it is
# on everywhere except a deployment that names itself production (APP_ENV,
# ENVIRONMENT, RAILWAY_ENVIRONMENT_NAME, VERCEL_ENV = "production"), where it
# stays off until set here by name. That default is the point: PAYMENT_MODE
# falls back to "demo", so a production deployment that simply never set it
# would otherwise be handing out ACT passes for free.
#
# Set this to true on a demo or showcase deployment, INCLUDING a production
# one, to keep the simulated checkout working there.
# DEMO_PAYMENTS_ENABLED=true

NEWS_API_KEY=your_news_api_key_here
FRED_API_KEY=your_fred_api_key_here
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key_here

# Zoho Books Integration
ZOHO_CLIENT_ID=your_zoho_client_id_here
ZOHO_CLIENT_SECRET=your_zoho_client_secret_here
ZOHO_REDIRECT_URI=http://127.0.0.1:8000/zoho/callback

# Gmail Auto-Import (bank alert emails)
GMAIL_CLIENT_ID=your_gmail_oauth_client_id_here
GMAIL_CLIENT_SECRET=your_gmail_oauth_client_secret_here
GMAIL_REDIRECT_URI=http://127.0.0.1:8000/gmail/callback

# ---------------------------------------------------------------------------
# Voice mode (Vapi) — real-time voice-to-voice transport only.
# The Financial Twin backend stays the brain; Vapi reaches it through the
# authenticated tools on /voice/tool.
# ---------------------------------------------------------------------------
# Required. Public key from dashboard.vapi.ai -> API Keys. Safe in the browser.
VAPI_PUBLIC_KEY=your_vapi_public_key_here
# Required. This backend as reachable FROM Vapi servers. Locally: an ngrok /
# cloudflared tunnel to port 8000 (e.g. https://abc123.ngrok-free.app).
VAPI_SERVER_URL=https://your-tunnel-or-domain

# Optional. Private key — server-side assistant management only. Never sent to
# the browser.
VAPI_PRIVATE_KEY=
# Optional. Use a dashboard-managed assistant instead of the transient one this
# backend builds. When set, VAPI_SERVER_SECRET is enforced on tool calls and
# stays entirely server-side.
VAPI_ASSISTANT_ID=
VAPI_SERVER_SECRET=

# Optional model / voice / transcriber overrides (defaults shown).
VAPI_MODEL_PROVIDER=openai
VAPI_MODEL=gpt-4o-mini
VAPI_VOICE_PROVIDER=vapi
VAPI_VOICE_ID=Neha
VAPI_TRANSCRIBER_PROVIDER=deepgram
VAPI_TRANSCRIBER_MODEL=nova-2
VAPI_TRANSCRIBER_LANGUAGE=en

# Hard cap on a single call, in seconds (default 900).
VOICE_MAX_CALL_SECONDS=900
# Voice transcripts are NOT Financial Twin memory. Leave false unless you
# explicitly want spoken conversations written to chat history.
VOICE_PERSIST_TRANSCRIPTS=false

# --- Omnidim outbound AI phone calls (the dashboard's "Call Varta" button) ---
# Separate provider from Vapi: Vapi is the in-browser voice session, Omnidim
# places a real outbound telephone call. Leave OMNIDIM_API_KEY empty to keep
# the feature off; the dispatcher returns a "not configured" result and no
# call is placed.
OMNIDIM_API_KEY=
OMNIDIM_AGENT_ID=
OMNIDIM_FROM_NUMBER_ID=
# Fallback destination used only when the caller has no phone on their profile.
# LEAVE THIS EMPTY unless you own the number. The assistant reads the calling
# user's own financial position aloud, so a shared default number means one
# user's figures are spoken to whoever answers it. Empty means the request is
# refused with "add a phone number to your profile" instead.
ALERT_PHONE_NUMBER=

# --- WhatsApp ---
# Meta WhatsApp Cloud API credentials for outbound messages. Leave both empty
# to keep WhatsApp sending off.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Token Meta echoes back when verifying the webhook. Set your own value: the
# fallback in backend/routers/whatsapp.py is in the repository, so it is public.
# Left commented on purpose -- an empty value here would replace that fallback
# with an empty token.
# WHATSAPP_VERIFY_TOKEN=
# POST /whatsapp/test-send is a development helper that sends an arbitrary
# message to an arbitrary number through the project's Evolution account.
# It requires a logged-in caller AND this flag. Leave unset outside local dev.
WHATSAPP_TEST_SEND=false

# --- Background jobs ---
# Off by default. Set true on exactly ONE machine (staging or production):
# these jobs send real WhatsApp messages and generate Daily AI Insights, so
# running several backends against one database multiplies every send.
ENABLE_SCHEDULER=false
