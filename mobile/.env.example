# MoneyKal mobile — environment
#
# Copy to `.env` and adjust. Every value is optional: with none of them set the
# app derives its API host from the Expo dev server it was loaded from, which
# is the correct address on a physical device with no configuration at all.

# Explicit backend URL. Set this for emulator work, a staging host, or
# production. Always wins over auto-detection.
#
#   Android emulator   http://10.0.2.2:8000
#   iOS simulator      http://localhost:8000
#   Physical device    http://<your-machine-LAN-IP>:8000
#   Production         https://api.your-domain.com
#
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# Port used when the host is auto-detected. The FastAPI dev server's default.
# EXPO_PUBLIC_API_PORT=8000
